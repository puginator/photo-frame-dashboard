{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "home-dashboard",
  "compatibility_date": "2026-09-30",
  "main": "./worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Family photos, private: only worker.js reads them (see docs/photos.md).
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "home-photos" }]
}
